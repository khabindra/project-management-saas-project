# ==========================================
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
bin/
include/
lib/
share/
pip-log.txt
pip-delete-this-directory.txt

# Poetry / Pipenv specific (Keep the lockfiles, ignore local caches)
.pypackages/
.poetry/
.pdm-build/

# ==========================================
# IDEs and Editors
# ==========================================
# VS Code
