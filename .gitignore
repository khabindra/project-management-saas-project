*.sqlite3
*.sqlite3-journal

# Gathered static assets & user uploads
local_settings.py
staticfiles/
static_cdn/
media/
media_cdn/

# DRF Browsable API cache or specific build files
.webassets-cache

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.local
.env.*.local
*.env
*.secret
*.key
*.pem

